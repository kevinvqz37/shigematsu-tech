{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://chikugo-dispatch.vercel.app/demo.html",
      "permanent": false
    },
    {
      "source": "/trial",
      "destination": "https://chikugo-dispatch.vercel.app/trial",
      "permanent": false
    },
    {
      "source": "/castwise",
      "destination": "https://castwise-fly.vercel.app/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/social-post",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/social-post",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/social-post.js": {
      "maxDuration": 120,
      "includeFiles": "social/queue.json"
    }
  }
}
